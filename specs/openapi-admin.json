              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 80
            }
          }
        }
      },
      "Path": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "courseIds",
          "status",
          "revision"
        ],
        "properties": {
